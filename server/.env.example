# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development

# SQLite path used by Prisma (kept as a literal file: path - see schema.prisma).
DATABASE_URL=file:./dev.db

# Required. Signs admin JWTs. There is no insecure fallback - the server
# refuses to start without this (see server/config.js). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required to allow admin self-registration via POST /api/auth/register.
# If unset, registration is disabled entirely (fail closed). On Render this
# is auto-generated (render.yaml) - copy it from the Render dashboard.
ADMIN_SETUP_KEY=

ACCESS_TOKEN_EXPIRY=15m

# Origin allowed to call the API with credentials. Your Vite dev server by default.
CORS_ORIGIN=http://localhost:5173

# Optional. PEM-encoded RSA private key for the election keypair used to
# encrypt/decrypt ballot choices. If unset, a keypair is generated in memory
# at boot (fine for a demo, but it rotates - and invalidates existing
# ballots - on every restart). See server/election-keys.js.
ELECTION_PRIVATE_KEY=
