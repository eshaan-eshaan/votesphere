// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin users who can access the dashboard
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relation to refresh tokens
  refreshTokens RefreshToken[]
}

// The election decryption key, encrypted with a key derived from JWT_SECRET so it
// survives restarts. (ELECTION_PRIVATE_KEY in the environment overrides this.)
model ElectionKey {
  electionId          String   @id
  encryptedPrivateKey String
  createdAt           DateTime @default(now())
}

// One election with a lifecycle: DRAFT -> REGISTRATION -> VOTING -> CLOSED.
// ringHash is set when the ring is frozen (REGISTRATION -> VOTING).
model Election {
  id        String   @id
  title     String
  status    String   @default("DRAFT")
  ringHash  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The electoral roll: one row per flat, the registered owner is the voting member.
// Eligibility is derived: duesCleared && !titleDisputed (see server/routes/election.js).
model Member {
  id             String   @id @default(uuid())
  membershipNo   String   @unique
  unitLabel      String   @unique
  block          String
  floor          Int
  flatNo         String
  bhk            Int
  fullName       String
  jointOwnerName String?
  aadhaarMasked  String
  phoneMasked    String
  ownership      String
  occupancy      String
  memberSince    Int
  duesCleared    Boolean
  titleDisputed  Boolean

  credentials Credential[]
}

// A single-use voting code per eligible member. Only an HMAC of the code is
// stored; the plaintext exists only on the issued sheet. A redeemed credential
// is NOT linked to the ring key it registered (see RingMember).
model Credential {
  id         String    @id @default(uuid())
  electionId String
  memberId   String
  codeHmac   String    @unique
  issuedAt   DateTime  @default(now())
  redeemedAt DateTime?
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([electionId, memberId])
}

// Public keys registered by voters. Deliberately has no reference to Member
// or Credential, so the registry cannot link a person to a ring key.
model RingMember {
  id         String @id @default(uuid())
  electionId String
  publicKey  String

  @@unique([electionId, publicKey])
  @@index([electionId])
}

// Encrypted votes stored in the ledger. No voter identity is stored.
model Vote {
  id              String   @id @default(uuid())
  ballotId        String   @unique
  electionId      String
  encryptedBallot String // choice, encrypted client-side with the election public key (see server/election-keys.js)
  keyImage        String   @unique // canonical Linkable Ring Signature tag (prevents double voting)
  ringSize        Int
  signature       String
  castAt          DateTime @default(now()) // rounded to a time bucket so it cannot be matched to registration times

  @@index([electionId])
}

// Refresh tokens for JWT rotation
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([token])
}
