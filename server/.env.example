# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development

# PostgreSQL connection string. Free options: Neon (neon.tech) or a local Docker container:
#   docker run -d --name votesphere-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=votesphere -p 5433:5432 postgres:16-alpine
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/votesphere
# For Neon use the DIRECT (non-pooled) string and keep ?sslmode=require.
DATABASE_URL=

# Required. Signs admin JWTs. There is no insecure fallback - the server
# refuses to start without this (see server/config.js). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Required to allow admin self-registration via POST /api/auth/register.
# If unset, registration is disabled entirely (fail closed). On Render this
# is auto-generated (render.yaml) - copy it from the Render dashboard.
ADMIN_SETUP_KEY=

ACCESS_TOKEN_EXPIRY=15m

# Origin allowed to call the API with credentials. Your Vite dev server by default.
CORS_ORIGIN=http://localhost:5173

# Optional. PEM RSA private key for the election. Normally leave this EMPTY:
# the key is generated once and stored encrypted in the database (under a key
# derived from JWT_SECRET), so it persists across restarts by itself.
ELECTION_PRIVATE_KEY=

# Optional. Comma-separated admin emails that get the superadmin role
# (required to reset the election). Survives database resets.
SUPERADMIN_EMAILS=
